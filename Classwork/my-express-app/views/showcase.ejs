<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Beautiful Display Page</title>
    <style>
      .button {
        display: inline-block;
        padding: 10px 20px;
        background-color: #007bff;
        color: white;
        text-decoration: none;
        border-radius: 5px;
        text-align: center;
      }
      .button:hover {
        background-color: #0056b3;
      }
    </style>
    <!-- Premium Google Fonts -->
    <link rel="preconnect" href="https://googleapis.com" />
    <link rel="preconnect" href="https://gstatic.com" crossorigin />
    <link
      href="https://googleapis.com/css2?family=Inter:wght@300;400;600&family=Playfair+Display:ital,wght@0,600;1,400&display=swap"
      rel="stylesheet"
    />

    <style>
      /* Modern Reset & Base Variables */
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        --bg-gradient: linear-gradient(
          135deg,
          #0f172a 0%,
          #1e1b4b 50%,
          #311042 100%
        );
        --panel-bg: rgba(255, 255, 255, 0.03);
        --panel-border: rgba(255, 255, 255, 0.08);
        --text-primary: #f8fafc;
        --text-secondary: #94a3b8;
        --accent-glow: linear-gradient(90deg, #a855f7, #6366f1);
        --font-sans: "Inter", sans-serif;
        --font-serif: "Playfair Display", serif;
      }

      body {
        font-family: var(--font-sans);
        background: var(--bg-gradient);
        color: var(--text-primary);
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow-x: hidden;
        padding: 2rem 1rem;
      }

      /* Ambient background glow effects */
      .glow-orb {
        position: absolute;
        width: 400px;
        height: 400px;
        border-radius: 50%;
        background: radial-gradient(
          circle,
          rgba(99, 102, 241, 0.15) 0%,
          rgba(0, 0, 0, 0) 70%
        );
        top: -10%;
        left: -10%;
        z-index: 0;
        pointer-events: none;
      }

      .glow-orb-2 {
        position: absolute;
        width: 500px;
        height: 500px;
        border-radius: 50%;
        background: radial-gradient(
          circle,
          rgba(168, 85, 247, 0.12) 0%,
          rgba(0, 0, 0, 0) 70%
        );
        bottom: -10%;
        right: -10%;
        z-index: 0;
        pointer-events: none;
      }

      /* Container Structure */
      .display-container {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 1000px;
        background: var(--panel-bg);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid var(--panel-border);
        border-radius: 24px;
        padding: 3.5rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        text-align: center;
      }

      /* Typography & Content Layout */
      .eyebrow {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.25em;
        background: var(--accent-glow);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 600;
        margin-bottom: 1.2rem;
      }

      h1 {
        font-family: var(--font-serif);
        font-size: 3.5rem;
        font-weight: 600;
        line-height: 1.15;
        margin-bottom: 1.5rem;
        letter-spacing: -0.02em;
      }

      h1 em {
        font-family: var(--font-serif);
        font-style: italic;
        font-weight: 400;
        opacity: 0.9;
      }

      .description {
        font-size: 1.15rem;
        color: var(--text-secondary);
        max-width: 600px;
        margin: 0 auto 3rem auto;
        line-height: 1.6;
        font-weight: 300;
      }

      /* Showcase Dynamic Grid */
      .showcase-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.5rem;
        margin-bottom: 3.5rem;
      }

      .showcase-card {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 16px;
        padding: 2rem;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        text-align: left;
      }

      .showcase-card:hover {
        transform: translateY(-5px);
        background: rgba(255, 255, 255, 0.04);
        border-color: rgba(255, 255, 255, 0.12);
        box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.3);
      }

      .card-icon {
        width: 42px;
        height: 42px;
        background: rgba(168, 85, 247, 0.1);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.25rem;
        color: #c084fc;
      }

      .showcase-card h3 {
        font-size: 1.25rem;
        margin-bottom: 0.5rem;
        font-weight: 600;
      }

      .showcase-card p {
        color: var(--text-secondary);
        font-size: 0.95rem;
        line-height: 1.5;
        font-weight: 300;
      }

      /* Action Buttons */
      .cta-group {
        display: flex;
        gap: 1rem;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
      }

      .btn {
        font-family: var(--font-sans);
        font-size: 0.95rem;
        font-weight: 600;
        padding: 0.85rem 2rem;
        border-radius: 12px;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .btn-primary {
        background: linear-gradient(90deg, #a855f7, #6366f1);
        color: #ffffff;
        border: none;
        box-shadow: 0 4px 20px rgba(99, 102, 241, 0.3);
      }

      .btn-primary:hover {
        opacity: 0.95;
        transform: scale(1.02);
        box-shadow: 0 6px 24px rgba(99, 102, 241, 0.4);
      }

      .btn-secondary {
        background: rgba(255, 255, 255, 0.05);
        color: var(--text-primary);
        border: 1px solid rgba(255, 255, 255, 0.1);
      }

      .btn-secondary:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.2);
      }

      /* Responsive Breakpoints */
      @media (max-width: 768px) {
        .display-container {
          padding: 2rem 1.5rem;
        }
        h1 {
          font-size: 2.5rem;
        }
        .description {
          font-size: 1rem;
          margin-bottom: 2rem;
        }
        .showcase-grid {
          margin-bottom: 2.5rem;
        }
      }
    </style>
  </head>
  <body>
    <!-- Ambient Visual Glow Orbs -->
    <div class="glow-orb"></div>
    <div class="glow-orb-2"></div>

    <!-- Main Presentation Card -->
    <main class="display-container">
      <a href="/" class="button">Go to Path</a>
      <div class="eyebrow">Minimal & Elegant</div>

      <h1>Designed <em>strictly</em> for presentation</h1>

      <p class="description">
        A flawless, glassmorphic single-page space engineered explicitly to
        display your curated content, projects, or core messaging with premium
        visual clarity.
      </p>

      <!-- Feature Grid Layout -->
      <div class="showcase-grid">
        <div class="showcase-card">
          <div class="card-icon">
            <svg
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                d="M9.813 15.904L9 21l5.545-3.168A9.013 9.013 0 1012 3v3h.007a6 6 0 11-2.194 10z"
              />
            </svg>
          </div>
          <h3>Pure HTML & CSS</h3>
          <p>
            Zero external JavaScript framework dependencies for blazing fast
            load times and clean compatibility.
          </p>
        </div>

        <div class="showcase-card">
          <div class="card-icon">
            <svg
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
              />
            </svg>
          </div>
          <h3>Fluid Design</h3>
          <p>
            Fully responsive grid environment that automatically rescales
            flawlessly for mobile, tablet, and desktop monitors.
          </p>
        </div>

        <div class="showcase-card">
          <div class="card-icon">
            <svg
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
              />
            </svg>
          </div>
          <h3>Atmospheric UI</h3>
          <p>
            Features embedded custom dynamic background depth gradients and
            sleek modern glass texture panels.
          </p>
        </div>
      </div>

      <!-- Action Callouts -->
      <div class="cta-group">
        <a href="#" class="btn btn-primary">Primary Action</a>
        <a href="#" class="btn btn-secondary">Learn More</a>
      </div>
    </main>
  </body>
</html>
