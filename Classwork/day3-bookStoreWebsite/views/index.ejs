<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>
  <body>
    <h1><%= title %></h1>
    <p>Welcome to <%= title %></p>

    <h2>Available Books</h2>
    <ul>
      <% books.forEach(function(book) { %>
        <li><strong><%= book.title %></strong> by <%= book.author %></li>
      <% }); %>
    </ul>
  </body>
</html>